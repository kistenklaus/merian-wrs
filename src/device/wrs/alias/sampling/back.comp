#version 460

#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_memory_scope_semantics : enable
// #extension GL_EXT_shader_atomic_float : enable
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_ARB_gpu_shader_int64 : enable
#pragma use_vulkan_memory_model

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint WORKGROUP_SIZE = 512;
layout(constant_id = 1) const uint COOPERATIVE_SAMPLE_SIZE = 32;

const uint UNIFORM_SAMPLER_TYPE_DICE_ROLLER = 1;
const uint UNIFORM_SAMPLER_TYPE_UINT64 = 2;

// const uint UNIFORM_SAMPLER = UNIFORM_SAMPLER_TYPE_DICE_ROLLER;
const uint UNIFORM_SAMPLER = UNIFORM_SAMPLER_TYPE_UINT64;

struct AliasTableEntry {
    float p;
    uint a;
};

layout(set = 0, binding = 0) readonly buffer inAliasTable {
    AliasTableEntry table[];
};

layout(set = 0, binding = 1) writeonly buffer outSamples {
    uint samples[];
};

layout(push_constant) uniform PushConstant {
    uint N;
    uint S;
    uint seed;
} pc;

// Constants for Philox2x32-10
const uint PHILOX_M2x32 = 0xD256D193u; // Multiplication constant
const uint PHILOX_W32 = 0x9E3779B9u; // Weyl constant
const uint PHILOX_ROUNDS = 7;

void philox2x32Round(inout uint x0, inout uint x1, uint k) {
    uint hi;
    uint lo;
    umulExtended(x0, PHILOX_M2x32, hi, lo);
    x0 = x1 ^ hi;
    x1 = lo + k;
}

// Philox2x32-10 implementation
void philox2x32(inout uint x0, inout uint x1, uint key) {
    uint k = key;
    for (int i = 0; i < PHILOX_ROUNDS; i++) {
        philox2x32Round(x0, x1, k);
        k += PHILOX_W32; // Update the key with the Weyl constant
    }
}

float randomFloat(uint source) {
    return source / 4294967295.0f;
    // uint pattern = 0x3f800000;
    // uint randomMant = source & 0x7fffff; // 23 random bits.
    // pattern |= randomMant;
    // return uintBitsToFloat(pattern) - 1.0f;
}

// Generate a random number using Philox2x32-10
uvec2 philoxRandom(uvec2 counter, uint key) {
    uint x0 = counter.x;
    uint x1 = counter.y;

    // Apply 10 rounds of Philox
    philox2x32(x0, x1, key);

    // Return a single random number normalized to [0, 1)
    return uvec2(x0, x1);
}

uint N;

// source is 32 fully random bits.
uint fastDiceRoller(uint source, uint n) {
    uint v = 1;
    uint c = 0;
    uint flip_pos = 31;
    while (true) {
        v = v << 1;
        c = c << 1;
        c += ((source & (1 << flip_pos)) >> flip_pos);
        flip_pos--;
        if (flip_pos == -1) { // overflowed

            source ^= c; // not 100% correct as it would theoretically require a fully new bitstream
            flip_pos = 31;
        }
        if (v >= n) {
            if (c < n) {
                return c;
            }
            v = v - n;
            c = c - n;
        }
    }
}

uint randomInt(uint source, uint n) {
    if (UNIFORM_SAMPLER == UNIFORM_SAMPLER_TYPE_DICE_ROLLER) {
        return fastDiceRoller(source, n);
    } else if (UNIFORM_SAMPLER == UNIFORM_SAMPLER_TYPE_UINT64) {
        return uint(randomFloat(source) * n);
    }
}

uint sampleSectioned(uvec2 counter, uint key) {
    uvec2 section;
    if (subgroupElect()) {
        uvec2 source64 = philoxRandom(counter, key ^ 0x495F5F70);
        uint u = randomInt(source64.x, N);
        const uint section_idx = u / COOPERATIVE_SAMPLE_SIZE;
        section.x = section_idx * COOPERATIVE_SAMPLE_SIZE;
        section.y = min(section.x + COOPERATIVE_SAMPLE_SIZE, N);
    }
    section = subgroupBroadcastFirst(section);

    const uvec2 source = philoxRandom(counter, key);
    const uint ix = section.x + fastDiceRoller(source.x, section.y - section.x);
    const float thresh = randomFloat(source.y);
    const float p = table[ix].p;
    if (thresh >= p) {
        return table[ix].a;
    } else {
        return ix;
    }
    return 0;
}

uint sampleBaseline(uvec2 counter, uint key) {
    const uvec2 source64 = philoxRandom(counter, key);
    uint ix = randomInt(source64.x, N);
    float thresh = randomFloat(source64.y);
    const float p = table[ix].p;
    if (thresh >= p) {
        return table[ix].a;
    } else {
        return ix;
    }
}

void main(void) {
    const uint gid = gl_GlobalInvocationID.x;

    N = pc.N;
    const uint S = pc.S;

    if (gid >= S) {
        return;
    }

    const uint key = pc.seed;
    uvec2 counter = uvec2(gl_WorkGroupID.x, gid);

    uvec2 section = ivec2(0, N); // [0,N) (inclusive, exclusive)
    if (COOPERATIVE_SAMPLE_SIZE != 0) {
        samples[gid] = sampleSectioned(counter, key);
    } else {
        samples[gid] = sampleBaseline(counter, key);
    }
}
